            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Email Configuration Problem\",\n  \"description\": \"Users are unable to send emails from the CRM system. Getting SMTP connection timeout error.\",\n  \"solution\": \"Updated SMTP server settings and tested successfully.\",\n  \"priority\": \"High\",\n  \"status\": \"Open\",\n  \"category\": \"Technical\",\n  \"severity\": \"Major\",\n  \"account_id\": 102,\n  \"contact_id\": 250,\n  \"assigned_to\": 5,\n  \"hours\": 3.5,\n  \"days\": 0.5,\n  \"organization_priority\": \"High\",\n  \"services_issue\": \"Email System\",\n  \"issue_end\": \"Resolved\",\n  \"email_sms_to_customer\": \"1\",\n  \"send_on_confirmation\": \"1\",\n  \"email_sms_assigned_to\": \"1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": ["{{base_url}}"],
              "path": ["tickets"]
            }
          }
        },
        {
          "name": "Add Comment to Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"This is a test comment added via API\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/456/comments",
              "host": ["{{base_url}}"],
              "path": ["tickets", "456", "comments"]
            }
          }
        }
